# Agent Watch configuration: the one file to edit to run your own copy.
#
#   make config        copies this file to agent-watch.env (mode 0600, git-ignored)
#                      and generates AW_HOST_TOKEN
#
# agent-watch.env holds the host token: never commit it, paste it or print it.
#
# Syntax (the Makefile includes the file, so these are make's rules):
#   - KEY=value, one per line, no spaces around '=' and no `export`
#   - no quotes: the value is the rest of the line, trimmed
#   - '#' starts a comment anywhere on a line, so a value cannot contain '#'
#   - a later line for the same key wins
#
# Read by: the Makefile (make configure-bridge, deploy-relay, watchos-config),
# agent-watch-bridge configure --env-file, deploy/relay/deploy.sh and the
# Wear OS Gradle build.

# ── Relay address ─────────────────────────────────────────────────────────
# Public host name of your relay, without scheme or path (an explicit port is
# allowed: relay.example.com:8443). Everything else is derived from it:
#   bridge:              wss://<domain>/v1/host   (make configure-bridge)
#   watch pairing field: https://<domain>         (Wear OS build, watchOS xcconfig)
AW_RELAY_DOMAIN=relay.example.com

# ── Shared secret ─────────────────────────────────────────────────────────
# Host token shared by the relay and the bridge: 64 hex characters.
# Leave it empty: `make config` generates it (openssl rand -hex 32) and never
# prints it. `make configure-bridge` gives it to the bridge and
# `make deploy-relay ARGS=--sync-env` to the relay.
AW_HOST_TOKEN=

# ── Relay deploy (make deploy-relay → deploy/relay/deploy.sh) ──────────────
# SSH target of the VPS: user@host or a Host alias from ~/.ssh/config. The
# user must be root (the script writes /usr/local/bin and runs systemctl).
AW_RELAY_SSH=
# Extra options for both ssh and scp. Use -o forms for the port (scp spells
# -p differently): -i ~/.ssh/<key> -o Port=2222
AW_RELAY_SSH_OPTS=

# ── Relay server environment (/etc/agent-watch-relay/env) ─────────────────
# Copied to the server only by `make deploy-relay ARGS=--sync-env`, key by
# key: an uncommented key (even with an empty value) replaces the server's
# value; a commented-out key leaves the server's line alone. AW_HOST_TOKEN
# above is synced the same way. Reference: docs/reference/contracts.md §5.
#
# Address the reverse proxy reaches; never a public interface.
#   nginx/Caddy on the host: 127.0.0.1:8080 · Nginx Proxy Manager in docker: 172.17.0.1:8080
# AW_LISTEN=127.0.0.1:8080
# Reverse proxies allowed to report the client IP (comma-separated CIDRs).
# AW_TRUSTED_PROXIES=127.0.0.1/32
# Single-IP header from a trusted proxy, e.g. CF-Connecting-IP. Only when the
# origin accepts traffic from that CDN alone, or clients can spoof it.
# AW_CLIENT_IP_HEADER=
# 1 once the installed Wear OS app handles the "resolved" push.
# AW_PUSH_RESOLVED=0
# Path ON THE SERVER to the Firebase service-account JSON (FCM push to Wear OS).
# Copy the JSON there yourself; it never goes through this file.
# AW_FCM_CREDENTIALS=/etc/agent-watch-relay/firebase-service-account.json
# ntfy push (watchOS). Empty URL: ntfy disabled.
# AW_NTFY_URL=https://ntfy.sh
# AW_NTFY_TOPIC=
# AW_NTFY_TOKEN=

# ── Watch apps ─────────────────────────────────────────────────────────────
# Wear OS: the application id stays com.gabriel.agentwatch; your Firebase
# project's Android app must use that package name (google-services.json).
#
# watchOS bundle id for `make watchos-config` (Phase 6 wires the generated
# watchos-app/Config.generated.xcconfig into the new project). Empty: the
# Xcode project's own bundle id.
AW_WATCHOS_BUNDLE_ID=
