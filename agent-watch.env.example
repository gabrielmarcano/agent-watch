# Agent Watch configuration: the one file to edit to run your own copy.
#
#   make config        copies this file to agent-watch.env (mode 0600, git-ignored)
#                      and generates AW_HOST_TOKEN
#
# agent-watch.env holds the host token: never commit it, paste it or print it.
# Syntax, every key and which tool reads it: docs/reference/contracts.md §7.

# Public host name of your relay, without scheme or path (a port is allowed).
AW_RELAY_DOMAIN=relay.example.com

# Host token shared by the relay and the bridge. Leave it empty: `make config`
# generates it and never prints it.
AW_HOST_TOKEN=

# For `make deploy-relay`: the VPS's SSH target (root) and extra ssh/scp
# options, e.g. -i ~/.ssh/<key> -o Port=2222 (deploy/relay/README.md).
AW_RELAY_SSH=
AW_RELAY_SSH_OPTS=

# Relay server environment: copied to /etc/agent-watch-relay/env only by
# `make deploy-relay ARGS=--sync-env`, and only the uncommented keys
# (deploy/relay/README.md § --sync-env). Meaning and defaults:
# docs/reference/contracts.md §5.
# AW_LISTEN=127.0.0.1:8080
# AW_TRUSTED_PROXIES=127.0.0.1/32
# AW_CLIENT_IP_HEADER=
# AW_PUSH_RESOLVED=0
# AW_FCM_CREDENTIALS=/etc/agent-watch-relay/firebase-service-account.json   # a path on the server
# AW_NTFY_URL=https://ntfy.sh
# AW_NTFY_TOPIC=
# AW_NTFY_TOKEN=

# watchOS bundle id for `make watchos-config`. Empty: the Xcode project's own.
AW_WATCHOS_BUNDLE_ID=
