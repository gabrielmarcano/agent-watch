# /etc/agent-watch-relay/env (root:agentwatch, 0640). Reference: docs/reference/contracts.md §5.

# Where the reverse proxy reaches the relay. Never a public interface.
#   nginx/Caddy on the host:        127.0.0.1:8080
#   Nginx Proxy Manager in docker:  172.17.0.1:8080  (+ the After=docker.service drop-in, see README.md)
AW_LISTEN=127.0.0.1:8080
AW_HOST_TOKEN=__generate_with_openssl_rand_hex_32__
AW_DATA_DIR=/var/lib/agent-watch-relay
# AW_FCM_CREDENTIALS=/etc/agent-watch-relay/firebase-service-account.json
# AW_NTFY_URL=https://ntfy.sh
# AW_NTFY_TOPIC=__random_unguessable_topic__
# AW_NTFY_TOKEN=

# Reverse proxies allowed to report the client IP (X-Forwarded-For, X-Real-IP)
# for the pairing rate limit. Empty: the TCP peer is the client.
#   nginx/Caddy on the host:        127.0.0.1/32
#   Nginx Proxy Manager in docker:  172.16.0.0/12 (or the NPM network's exact subnet)
# AW_TRUSTED_PROXIES=127.0.0.1/32
# Only when the origin accepts traffic from Cloudflare alone (clients can spoof it otherwise):
# AW_CLIENT_IP_HEADER=CF-Connecting-IP
