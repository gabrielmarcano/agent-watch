{
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go list:*)",
      "Bash(gofmt:*)",
      "Bash(make build)",
      "Bash(make bridge)",
      "Bash(make relay)",
      "Bash(make relay-linux)",
      "Bash(make test)",
      "Bash(make vet)",
      "Bash(make check)",
      "Bash(herdr --version)",
      "Bash(herdr agent list)",
      "Bash(herdr agent get:*)",
      "Bash(herdr agent read:*)",
      "Bash(herdr pane get:*)",
      "Bash(herdr workspace list)",
      "Bash(herdr integration status)",
      "Bash(herdr api schema:*)",
      "Bash(herdr plugin list)",
      "Bash(herdr plugin action list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_bash.py\"" },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_secrets.py\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_paths.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_contract_guard.py\"" }
        ]
      }
    ]
  }
}
