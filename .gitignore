# Agent Watch Root .gitignore

# Build outputs
bin/

# Secrets and configuration
# agent-watch.env holds the host token (agent-watch.env.example is committed;
# agent-watch.env.* also covers the temp files `make config` writes).
agent-watch.env
agent-watch.env.*
!agent-watch.env.example
/watchos-app/Config.generated.xcconfig
firebase-service-account*.json
store.json
.env*
!*.example
google-services.json
local.properties

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Large Android profiling files
*.hprof

# Android Build files
**/build/
**/.gradle/
**/.cxx/
*.apk
*.aab

# Xcode User Data
xcuserdata/
*.xcuserstate

# Legacy files (anchored: must not match pkg/bridge or cmd/bridge)
/bridge/
